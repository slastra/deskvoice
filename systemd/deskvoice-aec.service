# Echo-cancelled mic for deskvoice (config: ~/.config/pipewire/deskvoice-aec.conf)
[Unit]
Description=Echo-cancelled webcam mic for deskvoice's wake word
After=pipewire.service wireplumber.service
BindsTo=pipewire.service
Before=deskvoice.service

[Service]
ExecStart=/usr/bin/pipewire -c deskvoice-aec.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=pipewire.service
