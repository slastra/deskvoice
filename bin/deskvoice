#!/usr/bin/env python3
"""Launcher for a source checkout. The client is standard library only and runs
on the system python for a fast start (it is what notification hooks call);
`deskvoice serve` execs the project venv, which holds Kokoro and onnxruntime.
Installed with `uv tool install`, the `deskvoice` entry point does both."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

if len(sys.argv) > 1 and sys.argv[1] == "serve":
    py = os.path.join(ROOT, ".venv", "bin", "python")
    os.execv(py, [py, "-m", "deskvoice.server", *sys.argv[2:]])

sys.path.insert(0, ROOT)
from deskvoice.client import main  # noqa: E402

sys.exit(main())
